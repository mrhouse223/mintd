# Copy to .env in this same folder, fill in, then: chmod 600 .env
# .env must never be committed or shared.

# --- Telegram ---------------------------------------------------------------
TG_BOT_TOKEN=123456:your_botfather_token
TG_CHAT_ID=-1001234567890
# optional: post MGLD alerts to a different chat
# MGLD_CHAT_ID=-100...

# ignore buys under this many USDT0
MIN_USD=1

# --- Arb keeper -------------------------------------------------------------
ARB=0x70F90F4B32C5b2B6c4a1b8Ffb0f4C16dD950EE53

# Use a DEDICATED wallet that holds only a few dollars of gas.
# The arb float lives inside the contract, so this key can never touch it.
# Never put the deployer key here.
KEEPER_KEY=0x...

ARB_MAX_SIZE=250
ARB_POLL_MS=20000
