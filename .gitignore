node_modules/
build/
.env
.env.local
*.log
.DS_Store

# deployment records ARE worth committing: they are how you find your contracts
# again. Nothing secret lives in them.
!deployments/

# stats-cache.json is committed on purpose. The RPC prunes history after about
# four days, so this file is the only durable record of volume older than that
# window. Losing it silently resets all-time volume to whatever the node still
# retains, with no error to notice.

# runtime lock, never committed
stats-indexer.lock
holder-ledger.lock

# Local Netlify folder
.netlify

# Keeper's vault-discovery cache. Rebuilt from the factory registry on demand,
# so losing it costs one page of reads, unlike stats-cache.json.
data/agent-vaults-*.json
data/stable-earn-cap.json
data/verified-tokens.json

# Keeper's last-seen price per pool. Machine-local and self-healing: a lost file
# costs one HOLD cycle while it re-reads a reference price. Unlike
# data/mintd-holder-ledger.json this is NOT irreplaceable, so it stays out of git
# rather than churning a commit every ten minutes.
data/vault-keeper-state.json

# Internal ops, security state and strategy: kept local, never in the public repo.
private/
